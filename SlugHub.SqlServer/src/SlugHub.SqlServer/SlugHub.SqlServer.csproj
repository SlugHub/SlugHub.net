<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <VersionPrefix>1.0.0</VersionPrefix>
    <PackageId>SlugHub.SqlServer</PackageId>
    <Description>SqlServer storage mechanism for SlugHub</Description>
    <PackageReleaseNotes>Targets modern .NET (net8.0, net10.0) and uses Microsoft.Data.SqlClient. Note Microsoft.Data.SqlClient encrypts connections by default (Encrypt=True).</PackageReleaseNotes>
    <PackageTags>slug text-slug url-slug sqlserver</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Install.sql" />
    <EmbeddedResource Include="Install.sql" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.89" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <!-- pinned above the version Microsoft.Data.SqlClient pulls in, for CVE-2026-70162 / CVE-2026-84008 -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\SlugHub\src\SlugHub.csproj" />
  </ItemGroup>

</Project>
